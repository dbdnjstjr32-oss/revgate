# Copy to .env (optional). docker compose / Makefile fall back to these defaults.

# Postgres 16
POSTGRES_USER=revgate
POSTGRES_PASSWORD=revgate
POSTGRES_DB=revgate
POSTGRES_PORT=5432

# Redis 7 (ARQ broker)
REDIS_PORT=6379

# MinIO (local stand-in for Cloudflare R2)
MINIO_ROOT_USER=revgate
MINIO_ROOT_PASSWORD=revgate-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# The upstream minio/minio + minio/mc images are no longer pullable from Docker Hub / quay.io.
# Defaults use the upstream-compatible community build; override if you have another source.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MC_IMAGE=pgsty/mc:RELEASE.2026-11-12T00-00-00Z

# Browser origin allowed by bucket CORS (Next.js dev server)
WEB_ORIGIN=http://localhost:3000
